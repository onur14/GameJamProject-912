  m_Script: {fileID: 11500000, guid: c59921a22062079419e0bffed4cfa04b, type: 3}
  m_Name: Y-01
  m_EditorClassIdentifier: Assembly-CSharp::DispatchScenarioData
  scenarioId: Y-01
  readyForPlay: 1
  sourceNotes: Ev yangını çağrısı; orman yangını ayrı Y-02 senaryosundadır.
  callerName: Batuhan
  callerLocation: Ankara, Çankaya
  emergencyType: Ev yangını
  situationSummary: Mutfakta yağ yangını başladı; alevler davlumbaza ulaşıyor.
  opening:
  - text: "Batuhan: Alo, mutfakta yangın çıktı! İtfaiye gönderin!"
    fromOperator: 0
  - text: "Operatör: 912 Acil. Adresinizi söyleyin; herkes evden çıkabiliyor mu?"
    fromOperator: 1
  - text: "Batuhan: Ankara Çankaya'da öğrenci evindeyiz. Kızgın yağ alev aldı, duman her yere yayılıyor!"
    fromOperator: 0
  - text: "Operatör: İtfaiyeyi yönlendirdim. Güvenli çıkışı açık tutun ve dumandan uzaklaşın."
    fromOperator: 1
  - text: "Batuhan: Arkadaşım bir sürahi su getirdi. Yanan yağın üstüne dökelim mi?"
    fromOperator: 0
  choiceA: "Evet, alevleri söndürmek için yanan yağa su dökün."
  choiceB: "Hayır! Yağa su dökmeyin. Güvenliyse ocağı kapatıp uzaklaşın ve binayı tahliye edin."
  correctChoiceIsB: 1
  resourceA: 0
  resourceB: 0
  dispatchA: 1
  dispatchB: 1
  correctChoiceCost: 1
  wrongChoiceCost: 2
  outcomeA:
  - text: "Batuhan: Suyu döktük... Alevler bir anda büyüdü! Mutfaktan çıkamıyoruz, yardım edin!"
    fromOperator: 0
  - text: "Telsiz: Evde mahsur kalanlar var. İki itfaiye ekibi müdahaleye gidiyor."
    fromOperator: 0
  outcomeB:
  - text: "Batuhan: Ocağı kapatıp dışarı çıktık. İtfaiye geldi, hepimiz güvendeyiz."
    fromOperator: 0
