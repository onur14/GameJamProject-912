  m_Script: {fileID: 11500000, guid: c59921a22062079419e0bffed4cfa04b, type: 3}
  m_Name: K-01
  m_EditorClassIdentifier: Assembly-CSharp::DispatchScenarioData
  scenarioId: K-01
  readyForPlay: 1
  callerName: Emre
  callerLocation: ""
  emergencyType: Söylenti teyidi
  situationSummary: Deprem söylentisi nedeniyle bölgede panik yaşanıyor.
  sourceNotes: "Kaynak: kullan\u0131c\u0131n\u0131n 17.10.2026 tarihli k\u0131sa senaryo metni. Yaln\u0131zca konu\u015fmalar ve se\u00e7enekler g\u00fcncellendi; oyun kurallar\u0131 korundu."
  opening:
  - text: "Operat\u00f6r: 912 \u0130hbar ve Teyit Masas\u0131, buyrun?"
    fromOperator: 1
  - text: "KAZAZEDE: \u0130yi g\u00fcnler, haber edit\u00f6r\u00fc Emre ben. WhatsApp'ta bir ses kayd\u0131 patlad\u0131 az \u00f6nce."
    fromOperator: 0
  - text: "Operat\u00f6r: \u0130\u00e7eri\u011fi nedir Emre Bey?"
    fromOperator: 1
  - text: "Emre: Biri 'Gece 03:15'te 7.8 deprem olacak' diyor. Herkes soka\u011fa d\u00f6k\u00fcld\u00fc, benzinliklerde izdiham var, panik b\u00fcy\u00fck!"
    fromOperator: 0
  - text: "Operat\u00f6r: \u0130zdiham b\u00f6lgesine tedbiren bir ambulans ekibi \u00e7\u0131kar\u0131yorum."
    fromOperator: 1
  - text: "Emre: Halk panikte, sitemizde 'Uzmanlar uyard\u0131' diye man\u015fetten ge\u00e7elim mi haberi?!"
    fromOperator: 0
  choiceA: "Payla\u015f\u0131n, tedbirli olmakta zarar yok, halk bilsin."
  choiceB: "SAKIN PAYLA\u015eMAYIN! Depremin g\u00fcn\u00fc ve saati B\u0130L\u0130NEMEZ! Bu yalan bilgiyi yalanlay\u0131n!"
  correctChoiceIsB: 1
  resourceA: 1
  resourceB: 2
  dispatchA: 1
  dispatchB: 0
  outcomeA:
  - text: "Emre: Ge\u00e7tim haberi... \u015eehir fel\u00e7 oldu operat\u00f6r! Trafik t\u0131kand\u0131, panikle kazalar oldu, izdihamda ezilenler var!"
    fromOperator: 0
  outcomeB:
  - text: "Operat\u00f6r: Emre Bey yalan haber! Deprem saati bilinemez. Haberi derhal 'AFAD Yalanlad\u0131: Saatli deprem iddias\u0131 sahtedir' diye ge\u00e7in!"
    fromOperator: 1
  - text: "Emre: Yalanlama haberi ge\u00e7tik, panik dalgas\u0131 an\u0131nda duruldu, g\u00f6nderdi\u011finiz ambulans izdihamdaki hafif fenala\u015fanlara m\u00fcdahale etti."
    fromOperator: 0
