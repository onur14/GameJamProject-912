  m_Script: {fileID: 11500000, guid: 7c5b4f13a1387a18ae82d5885885ce84, type: 3}
  m_Name: T-02
  m_EditorClassIdentifier: TahaYasin.Runtime::DispatchScenarioData
  scenarioId: T-02
  readyForPlay: 1
  sourceNotes: "Kaynak: afet_senaryolari_kaynak_12.md. Vatanda\u015F s\xF6zleri kaynaktan aynen al\u0131nm\u0131\u015Ft\u0131r."
  opening:
  - text: "Operat\xF6r: 912 Acil, buyrun?"
    fromOperator: 1
  - text: "KAZAZEDE: Selam\xFCn aleyk\xFCm evlad\u0131m. Ben bal\u0131k\xE7\u0131 Cemal. Seferihisar k\u0131y\u0131s\u0131nday\u0131z. Demin tsunami oldu hani, sokaklar\u0131 su bast\u0131yd\u0131. \u015Eimdi sular geri \xE7ekildi, liman sakinle\u015Fti."
    fromOperator: 0
  - text: "Operat\xF6r: Cemal Kaptan, \u015Fu an y\xFCksek ve g\xFCvenli bir yerde misiniz?"
    fromOperator: 1
  - text: "Cemal: Yukar\u0131 kahvedeydim de, benim ekmek teknem iskelede ba\u011Fl\u0131yd\u0131, ipleri kopmu\u015F gibi duruyor. Sular \xE7ekilmi\u015Fken hemen ineyim de tekneyi sa\u011Flama alay\u0131m diyorum, 30 y\u0131ll\u0131k eme\u011Fim batmas\u0131n!"
    fromOperator: 0
  - text: "Cemal: \u0130lk dalga geldi ge\xE7ti i\u015Fte evlat. \xC7izmeleri \xE7ekip marinaya ineyim mi tekne i\xE7in?"
    fromOperator: 0
  choiceA: "Su \xE7ekildiyse h\u0131zl\u0131ca gidip teknenizi ba\u011Flay\u0131n ve hemen geri \xE7\u0131k\u0131n."
  choiceB: "SAKIN \u0130NMEY\u0130N! Tsunami tek dalga de\u011Fildir, as\u0131l b\xFCy\xFCk ikinci dalga birazdan vurabilir!"
  correctChoiceIsB: 1
  resourceA: 2
  resourceB: 2
  dispatchA: 1
  dispatchB: 1
  outcomeA:
  - text: "Cemal: Eyvallah indim iskeleye... Halat\u0131 yakalad\u0131m tam... Dur bir dakika, denizden derin bir u\u011Fultu geliyor yine! A-aaa! Bu sefer gelen su simsiyah ve ilk dalgadan iki kat b\xFCy\xFCk! \u0130skele par\xE7alan\u0131yo---"
    fromOperator: 0
  outcomeB:
  - text: "Operat\xF6r: Cemal Kaptan sak\u0131n iskeleye ad\u0131m atmay\u0131n! Tsunami bir dalga serisidir. \u0130lk dalgadan sonra as\u0131l devasa ikinci dalga gelir! Can\u0131n\u0131z tekneden \xF6nemli, tehlike ge\xE7ti duyurusu yap\u0131lana kadar yukar\u0131da kal\u0131n!"
    fromOperator: 1
  - text: "Cemal: Deme yav... Tamam, kahvenin bah\xE7esinde kal\u0131yorum... ANAM! O ne \xF6yle! Az \xF6nce inece\u011Fim iskele komple g\xF6m\xFCld\xFC suyun alt\u0131na! Dalga tekneleri kibrit \xE7\xF6p\xFC gibi k\u0131rd\u0131... Evlat sen benim can\u0131m\u0131 kurtard\u0131n be."
    fromOperator: 0
